# Copy to .env and fill locally. Never commit .env or credentials.
HF_TOKEN=
MEETING_DEVICE=auto
MEETING_ASR_BATCH_SIZE=1

# Enable only after choosing a provider/model and configuring its endpoint/key.
MEETING_LLM_ENABLED=false
MEETING_LLM_PROVIDER=http
MEETING_LLM_MODEL=
MEETING_LLM_BASE_URL=
MEETING_LLM_API_KEY=

# Optional: generated from dev predictions, then frozen for test.
MEETING_CONFIDENCE_CALIBRATION=
# Optional outside Linux: path to a Vietnamese-compatible Unicode TTF.
MEETING_PDF_FONT=
