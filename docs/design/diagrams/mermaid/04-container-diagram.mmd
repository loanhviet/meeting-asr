  UI["Browser UI<br/>[Container: React / TypeScript]<br/>Meeting review and audio player"]
  WEB["Web server<br/>[Container: Next.js / Node.js]<br/>Serves UI; /api rewrite in Compose"]
  API["Backend application<br/>[Container: FastAPI / Python]<br/>REST, JobWorker thread;<br/>child inference process"]
  CLI["Research CLI<br/>[Container: Python]<br/>Direct pipeline and evaluation"]
  DB[("Job database<br/>[Data Store: SQLite WAL]<br/>Jobs, edits, names and answers")]
  DISK[("Artifacts and caches<br/>[Data Store: Filesystem]<br/>Audio, JSON, RTTM and checkpoints")]
