title 17 - Frontend Component Diagram
left to right direction
package "Next.js application" {
 component "app/page.tsx" as Page
 package "Browser React modules" {
  component "MeetingApp" as App
  component "MeetingPlayer" as Player
  component "MinutesPanel" as Minutes
  component "AskMeetingPanel" as Ask
  component "ReviewControls\nTurnEditor / SpeakersDialog /\nHistoryDialog / Modal" as Review
  component "lib/api.ts\nrequest(), types and API base" as Client
 }
}
component "FastAPI /api/*" as API
Page ..> App : imports
App ..> Player : renders / audio ref
App ..> Minutes : renders / source navigation
App ..> Ask : renders / source navigation
App ..> Review : renders / edit callbacks
App ..> Client : jobs / health / poll / upload
Minutes ..> Client : regenerate minutes
Ask ..> Client : questions and history
Review ..> Client : edits / merges / history
Player ..> Client : imports API base / time helper
Client --> API : HTTP fetch
App --> API : export links
Player --> API : audio src
